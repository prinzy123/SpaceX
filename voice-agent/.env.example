# =====================================================================
#  Copy this file to ".env" and fill in the values you have.
#  You do NOT need all of them. Start with just ONE model key.
#  NEVER commit the real .env file to git. (.gitignore already blocks it.)
# =====================================================================

# ---------------------------------------------------------------------
# 1. THE BRAIN — pick ONE (you can add the other later)
# ---------------------------------------------------------------------
# Claude (recommended). Get it at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ChatGPT. Get it at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Which brain to use: "claude", "openai", or "echo" (offline demo, no key needed)
LLM_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------
# 2. THE PHONE — only needed when you want it to actually CALL people
#    Sign up at https://twilio.com, buy a number (~$1/month)
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15550001111

# The public URL of your server so Twilio can reach it.
# While testing, run:  ngrok http 8000   and paste the https URL here.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ---------------------------------------------------------------------
# 3. YOU — so the agent can introduce itself correctly on calls
# ---------------------------------------------------------------------
OWNER_NAME=Your Name
OWNER_PHONE=+15550002222
OWNER_EMAIL=you@example.com
OWNER_TIMEZONE=Africa/Lagos

# ---------------------------------------------------------------------
# 4. SAFETY
# ---------------------------------------------------------------------
# true  = the agent must ask you before dialling anyone (STRONGLY recommended)
# false = it dials on its own. Only for numbers you fully trust.
REQUIRE_CALL_APPROVAL=true

# Password for your web server (used by the ChatGPT Custom GPT). Make one up.
SERVER_API_KEY=choose-a-long-random-string
